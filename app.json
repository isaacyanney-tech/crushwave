{
  "expo": {
    "name": "Crushwave",
    "slug": "crushwave",
    "scheme": "crushwave",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.crushwave",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Crushwave uses your photos so you can add pictures to your profile.",
        "NSCameraUsageDescription": "Crushwave uses the camera for profile photos and for the selfie that verifies your profile.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.crushwave",
      "adaptiveIcon": {
        "backgroundColor": "#FF4D6D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FF4D6D"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Crushwave uses your photos so you can add pictures to your profile.",
          "cameraPermission": "Crushwave uses the camera for profile photos and for the selfie that verifies your profile.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF4D6D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supabaseUrl": "https://ccefprnjkgdpbqbwjlso.supabase.co",
      "supabasePublishableKey": "sb_publishable_AXGzJdQ9qiZ_soZoiGglCA_qtBTCGwR"
    }
  }
}
